# ── Pulso backend · variables de entorno ──────────────────────────────
# Copia este archivo a .env y rellena valores. NUNCA subas .env al repo.

NODE_ENV=development
PORT=3001

# Origen permitido para CORS (la app/web del paciente)
CORS_ORIGIN=http://localhost:5173

# ── Secretos (genera valores largos y aleatorios en producción) ───────
# openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_fedcba9876543210

# Clave de cifrado de datos de salud (PHI) en reposo. 32 bytes en hex (64 chars).
# openssl rand -hex 32
PHI_ENC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Caducidad de tokens
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
VERIFY_TTL_HOURS=24

# Admin de arranque (se crea al iniciar si no existe ninguno). Cámbialo.
ADMIN_EMAIL=admin@pulso.es
ADMIN_PASSWORD=CambiaEstoYa_2026

# Roles a los que se exige 2FA (CSV). Vacío = nadie obligado.
REQUIRE_2FA_ROLES=doctor,admin

# Sembrar un médico de demostración verificado al arrancar (para probar el matching).
# Crea doctor@pulso.es / Doctor2026 (Dermatología). Pon false en producción.
SEED_DEMO=true

# App / web del paciente (a donde apuntan los enlaces de los emails)
APP_URL=http://localhost:5173
# URL pública de esta API (para el enlace de verificación de un clic)
API_URL=http://localhost:3001

# ── Email ─────────────────────────────────────────────────────────────
# MAIL_TRANSPORT=console  -> demo: no envía, guarda previsualización en ./outbox
# MAIL_TRANSPORT=smtp     -> producción: envío real (rellena SMTP_*)
MAIL_TRANSPORT=console
MAIL_FROM=Pulso <no-reply@pulso.es>
# Proveedor transaccional con residencia UE (p. ej. Brevo, Mailjet, Scaleway, SES eu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Base de datos ─────────────────────────────────────────────────────
# DEMO: SQLite embebido (archivo local). No requiere servidor.
DB_FILE=./pulso.db
# PRODUCCIÓN: PostgreSQL gestionado en la UE. La capa de datos (src/db.ts)
# está aislada para sustituir SQLite por pg sin tocar la lógica de negocio.
# DATABASE_URL=postgresql://user:pass@host:5432/pulso?sslmode=require

# ── Pagos ──
# Sin clave de Stripe, los pagos funcionan en modo demostración (no se cobra).
# Para cobrar de verdad, pon tu clave secreta de Stripe (la del panel de Stripe):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENTS_CURRENCY=eur

# ── Parte médica ──
# Porcentaje del importe de cada consulta que se devenga al médico (resto: comisión).
DOCTOR_PAYOUT_PCT=70
# Carpeta local para documentos subidos (en producción: bucket S3 en la UE).
UPLOAD_DIR=./uploads
